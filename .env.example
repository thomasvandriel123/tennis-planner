# Copy this file to .env.local (for `next dev`) and .env (for the Prisma
# CLI, which does not read .env.local) and fill in real values.
# Never commit an actual .env or .env.local file.

# --- Database ---------------------------------------------------------------
# Local dev: `docker compose up -d` starts a matching Postgres (see README).
DATABASE_URL="postgresql://tennis:tennis@localhost:5432/tennis_planner?schema=public"

# --- Auth.js (magic-link sign-in) -------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Transactional email (magic links, notifications) -----------------------
# https://resend.com - used both as the Auth.js email provider and for
# assignment/payment/update notification emails.
RESEND_API_KEY=""
EMAIL_FROM="Tennis Club <no-reply@example.com>"

# --- Payments -----------------------------------------------------------------
# https://mollie.com - test API key starts with "test_".
MOLLIE_API_KEY=""
